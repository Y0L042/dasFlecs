options gen2
require daslib/fio

[export]
def initialize(project_path : string) {
    if (das_is_dll_build()) {
        register_dynamic_module("{project_path}/_build/Release/dasModuleFlecsGen.shared_module", "Module_dasFlecs")
    }
    for (name in ["flecs_boost", "flecs_helpers", "flecs_cpp", "flecs_macros"]) {
        register_native_path("flecs", name, "{project_path}/dasFlecs/flecs/{name}.das")
    }
}
